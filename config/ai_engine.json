{
  "_note": "B · 企业 AI 服务层引擎参数与权限。所有判定在本地完成：关键词/字符 n-gram 检索 + 规则路由，不调用外部模型或 API。",
  "version": "AI-B.1.0",
  "engine": {
    "id": "local-rules",
    "label": "本地规则引擎",
    "disclosure": "本地确定性关键词与规则引擎，非外部大模型，不调用任何外部 API。",
    "languages": [
      "zh",
      "en",
      "ja"
    ],
    "languageLabels": {
      "zh": "中文",
      "en": "English",
      "ja": "日本語"
    }
  },
  "chunking": {
    "maxChars": 180,
    "minChars": 24,
    "maxChunks": 60
  },
  "search": {
    "topKDefault": 3,
    "topKMax": 8,
    "minScore": 2,
    "weights": {
      "keyword": 6,
      "bigram": 2,
      "trigram": 1,
      "title": 2,
      "glossary": 4,
      "phrase": 8
    }
  },
  "limits": {
    "contentMaxChars": 12000,
    "titleMaxChars": 120,
    "queryMaxChars": 200,
    "messageMaxChars": 2000,
    "sessionMessages": 200,
    "runListLimit": 50
  },
  "workflow": {
    "maxSteps": 20,
    "retryLimit": 3,
    "notifyChannel": "in_app"
  },
  "emailPattern": "^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$",
