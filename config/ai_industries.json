      "knowledgeDocs": [
        {
          "id": "kb-wd-moisture",
          "title": "木材含水率与榫卯稳定性",
          "version": "v1.2",
          "status": "published",
          "source": "木作工艺标准（合成样例）",
          "owner": "木作工艺组（合成）",
          "updatedAt": "2026-10-20",
          "chunks": [
            {
              "text": "实木家具投产前含水率应控制在 8%–12%，南方梅雨季建议上限 10%。每批木材需在养生 7–14 天后复测，含水率偏差超过 2% 的板材必须二次平衡。",
              "keywords": [
                "含水率",
                "实木",
                "养生",
                "板材",
                "梅雨季"
              ]
            },
            {
              "text": "榫卯配合间隙控制在 0.2–0.4mm，过紧会挤裂木纤维，过松会影响结构强度；组装前需在暗榫处预留 0.1mm 的胶层空间。",
              "keywords": [
                "榫卯",
                "间隙",
                "组装",
                "公差",
                "胶层"
              ]
            },
            {
              "text": "大板桌面含水率高于 12% 时，必须采用穿带或蝴蝶榫加固，并在背面开设卸力槽；开裂风险需在报价单中书面提示。",
              "keywords": [
                "大板",
                "穿带",
                "蝴蝶榫",
                "开裂",
                "卸力槽"
              ]
            }
          ]
        },
        {
          "id": "kb-wd-finish",
          "title": "木蜡油涂装与养护说明",
          "version": "v1.5",
          "status": "published",
          "source": "涂装车间作业卡（合成样例）",
          "owner": "涂装组（合成）",
          "updatedAt": "2026-10-16",
          "chunks": [
            {
              "text": "木蜡油采用两底两面工艺，每遍间隔 4 小时以上，最后一遍完成后 24 小时可轻度使用、7 天完全固化。施工环境温度宜在 15–30℃，湿度低于 75%。",
              "keywords": [
                "木蜡油",
                "两底两面",
                "固化",
                "湿度",
                "施工",
                "涂装"
              ]
            },
            {
              "text": "打磨从 180 目起步，逐级到 320 目，最后顺纹轻磨；涂装前用除尘布清除木粉，避免油膜出现颗粒。",
              "keywords": [
                "打磨",
                "目数",
                "除尘",
                "油膜"
              ]
            },
            {
              "text": "日常养护每 6–12 个月补涂一次木蜡油，先用 400 目砂纸顺纹轻磨再薄涂；不可使用含强碱或研磨颗粒的清洁剂。",
              "keywords": [
                "养护",
                "补涂",
                "清洁剂",
                "木蜡油"
              ]
            }
          ]
        },
        {
          "id": "kb-wd-custom",
          "title": "木作定制流程、交期与安装",
          "version": "v1.0",
          "status": "published",
          "source": "项目管理部交付手册（合成样例）",
          "owner": "项目管理组（合成）",
          "updatedAt": "2026-10-08",
          "chunks": [
            {
              "text": "定制流程为需求访谈、现场或远程测量、深化图确认、打样（可选）、生产、试装、包装发货与上门安装八个阶段。深化图确认后生产周期为 25–35 个自然日。",
              "keywords": [
                "定制流程",
                "测量",
