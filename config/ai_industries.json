            "type": "inquiry.created",
            "label": "官网询盘提交时"
          },
          "requiredInputs": [
            "name",
            "email",
            "interest"
          ],
          "inputExample": {
            "name": "周先生",
            "email": "zhou@example.com",
            "country": "CN",
            "interest": "18K 金婚戒定制",
            "budget": "80000",
            "lang": "zh"
          },
          "steps": [
            {
              "name": "校验询盘必填字段",
              "type": "validate_input",
              "config": {
                "required": [
                  "name",
                  "email",
                  "interest"
                ],
                "emailField": "email"
              }
            },
            {
              "name": "检索工期与报价口径",
              "type": "search_knowledge",
              "config": {
                "queryField": "interest",
                "querySuffix": "工期 报价 起订量",
                "topK": 2
              }
            },
            {
              "name": "线索分级",
              "type": "score_lead",
              "config": {
                "aBudgetCents": 5000000,
                "bBudgetCents": 1500000,
                "priorityCountries": [
                  "US",
                  "JP",
                  "DE",
                  "GB",
                  "AU",
                  "CA"
                ]
              }
            },
            {
              "name": "写入 CRM",
              "type": "create_lead",
              "config": {
                "source": "工作流：珠宝询盘分诊"
              }
            },
            {
              "name": "生成报价草稿",
              "type": "draft_quote",
              "config": {
                "currency": "CNY",
                "baseRangeCents": [
                  2800000,
                  6800000
                ],
                "depositPct": 30,
                "validityDays": 7,
                "minQty": 10,
                "note": "按金重与主石参数复核"
              }
            },
            {
              "name": "通知运营组",
              "type": "notify",
              "config": {
                "to": "运营组",
                "channel": "in_app",
                "message": "新询盘 {leadId}：{name} / {interest} / 等级 {grade}"
              }
            },
            {
              "name": "A 级线索升级提醒",
              "type": "notify",
              "config": {
                "to": "销售负责人",
                "channel": "in_app",
                "message": "A 级线索 {leadId} 预算 {budgetText}，建议 2 小时内跟进"
              },
              "condition": {
                "field": "grade",
                "op": "eq",
                "value": "A"
              }
            }
          ]
        },
