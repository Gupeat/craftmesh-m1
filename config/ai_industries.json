      "knowledgeDocs": [
        {
          "id": "kb-jw-delivery",
          "title": "珠宝定制交付流程与工期口径",
          "version": "v1.3",
          "status": "published",
          "source": "珠宝工艺组内部作业手册（合成样例）",
          "owner": "工艺运营组（合成）",
          "updatedAt": "2026-10-18",
          "chunks": [
            {
              "text": "标准定制订单依次经过需求确认、设计出图、蜡模制作、执模、镶嵌、质检与交付七个节点。单件婚戒常规工期为 18–25 个自然日，起算点是设计稿书面确认且定金到账的次日。",
              "keywords": [
                "定制流程",
                "工期",
                "婚戒",
                "节点",
                "定金"
              ]
            },
            {
              "text": "加急单必须在需求确认时标注，工期可压缩至 12–15 个自然日，加收订单金额 15% 的加急费；加急不改变质检标准，只调整排产优先级。",
              "keywords": [
                "加急",
                "工期",
                "加急费",
                "排产"
              ]
            },
            {
              "text": "设计改款以两轮为限：第一轮免费，第二轮起每次收取设计工本费 300 元。已开蜡模后取消订单，按已发生工时结算，蜡模与执模费用不退。",
              "keywords": [
                "改款",
                "设计费",
                "取消订单",
                "蜡模",
                "执模"
              ]
            },
            {
              "text": "交付前必须完成金重、石重、圈口三项复核，并在质保单上记录净金重、主石证书编号、保养说明与售后期限。",
              "keywords": [
                "交付",
                "复核",
                "金重",
                "石重",
                "圈口",
                "质保单"
              ]
            }
          ]
        },
        {
          "id": "kb-jw-quote",
          "title": "珠宝定制报价口径与损耗规则",
          "version": "v2.0",
          "status": "published",
          "source": "珠宝报价评审纪要（合成样例）",
          "owner": "报价审核组（合成）",
          "updatedAt": "2026-10-21",
          "chunks": [
            {
              "text": "报价由金料、主石、副石、工费、损耗与税费构成。18K 金按当日基础金价乘以 0.75 折算，损耗率按 6% 计入金料成本；报价单需分别列出各项，不得合并为一口价。",
              "keywords": [
                "报价",
                "18K金",
                "损耗率",
                "金料",
                "税费",
                "工费"
              ]
            },
            {
              "text": "银饰与铜镀金产品按件报价，工费按工艺复杂度分三档：素圈 120 元起，镶嵌 280 元起，手工雕蜡 480 元起。批量订单 10 件起订，可按档位下调 8%–15%。",
              "keywords": [
                "银饰",
                "起订量",
                "工费",
                "批量",
                "10件"
              ]
            },
            {
              "text": "报价有效期为 7 个自然日，金价波动超过 3% 时可重新核价并书面告知客户。定金比例 30%，尾款在发货前结清。",
              "keywords": [
                "报价有效期",
                "定金",
                "尾款",
                "金价波动"
              ]
            }
          ]
        },
        {
          "id": "kb-jw-quality",
          "title": "珠宝质检标准与售后边界",
          "version": "v1.1",
          "status": "published",
          "source": "质检组作业指导书（合成样例）",
          "owner": "质检组（合成）",
          "updatedAt": "2026-10-12",
          "chunks": [
            {
              "text": "镶嵌类产品逐件检查爪位对称度、石台水平度与牢固度：爪镶单爪间隙不大于 0.05mm，轻压主石不得有松动；包镶边缘不得高于石面 0.1mm。",
              "keywords": [
                "质检",
                "爪镶",
                "牢固度",
                "包镶",
                "公差"
              ]
            },
            {
              "text": "抛光表面在 10 倍放大镜下允许存在不超过 0.02mm 的细微砂痕，不得有肉眼可见的划伤、麻点或镀层脱落。",
              "keywords": [
                "抛光",
                "砂痕",
                "镀层",
                "外观"
              ]
            },
            {
              "text": "售后提供 30 天内一次免费圈口调整（±2 号以内），非人为损坏提供 1 年保修；改色、改款、第三方维修过的产品不在保修范围。",
              "keywords": [
                "售后",
                "圈口调整",
                "保修",
                "人为损坏"
              ]
            }
          ]
        },
        {
          "id": "kb-jw-ring-size",
          "title": "圈口测量与尺寸换算（演示口径）",
          "version": "v1.0",
          "status": "published",
          "source": "门店测量培训材料（合成样例）",
          "owner": "零售支持组（合成）",
          "updatedAt": "2026-09-28",
          "chunks": [
            {
              "text": "圈口以港号为主、日号为辅。港号 12 对应内径约 16.5mm，港号 14 对应约 17.3mm，港号 16 对应约 18.1mm；换算表仅作参考，下单前应以实体测量为准。",
              "keywords": [
                "圈口",
                "港号",
                "内径",
                "换算",
                "测量"
              ]
            },
            {
              "text": "宽版戒指（宽度大于 6mm）建议在原圈口基础上加 0.5 号，避免佩戴过紧；冬季测量偏小、夏季偏大，复测应间隔 2 小时以上。",
              "keywords": [
                "宽版戒指",
                "圈口",
                "佩戴",
                "复测"
              ]
            }
          ]
        }
