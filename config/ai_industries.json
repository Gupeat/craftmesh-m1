      "workflowTemplates": [
        {
          "id": "wf-jw-inquiry",
          "name": "珠宝询盘分诊与首响应",
          "version": "v1.2",
          "status": "active",
          "description": "官网询盘进入后：校验字段 → 检索工期与报价口径 → 线索分级 → 写 CRM → 生成报价草稿 → 通知运营。",
